%%{init: {"theme": "base", "flowchart": {"curve": "basis", "nodeSpacing": 28, "rankSpacing": 44}, "themeVariables": {"fontFamily": "Arial, Helvetica, sans-serif", "fontSize": "16px"}}}%%
flowchart LR
    I["<b>1. Immutable inputs</b><br/><br/>Raw Combined / Brightfield / Dead / Nuclei images<br/>Frozen original + nucleated-only masks<br/><br/><b>Gate:</b> segmentation freeze must be verified"]
    B["<b>2. Base classification - every field</b><br/><br/>Combined RGB state<br/>Dead-object signal and cell relation<br/>Brightfield + nucleus support<br/><br/>Fuse channels into pre-refinement state<br/>Keep supplemental Dead objects"]
    C["<b>3. Continuous all-time calibration</b><br/><br/>Complete well/site trajectories<br/>Measure N:C, depletion, red loss, shape, Dead signal<br/><br/>Interpolate empirical live references over<br/>continuous density + 12-hour untreated time anchors<br/><b>No discrete time bins</b>"]
    R["<b>4. Same refinement logic for all images</b><br/><br/><b>Eligible:</b> current live + countable + non-border<br/><b>No treatment gate - no 72-hour gate</b><br/><br/>Field collapse: 4/5 signals + site + branch consensus<br/>Object multisignal + dual-view consensus<br/>Temporal-remnant tracking<br/>Matched-partner transfer<br/>Complementary cross-view multisignal rescue"]
    D["<b>5. Final decision and outputs</b><br/><br/>1 Preserve confirmed Dead<br/>2 Rescue supported live objects<br/>3 Field discordance is diagnostic / rescue veto<br/>4 One-signal branch conflict retains prior live state<br/>5 Multisignal unresolved conflict becomes uncertain<br/><br/><b>Hard gate:</b> uncertainty <=1% at every audit level<br/>Per-cell states + total / live / dead / uncertain<br/>summaries / bounds / QC / audit / reports<br/><br/><b>Operational proxies - no manual ground truth</b>"]
    X["Stop"]

    I -- "freeze verified" --> B
    I -- "freeze failed" --> X
    B --> C --> R --> D

    classDef input fill:#e8f1fb,stroke:#2b5d8a,color:#16344d,stroke-width:2px;
    classDef process fill:#eef6ee,stroke:#3e7443,color:#244529,stroke-width:2px;
    classDef output fill:#e8eef8,stroke:#4b6285,color:#26354c,stroke-width:2px;
    classDef warning fill:#fff0e5,stroke:#a85825,color:#5c3018,stroke-width:2px;

    class I input;
    class B,C,R process;
    class D output;
    class X warning;
